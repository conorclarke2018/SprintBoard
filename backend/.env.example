# Copy this file to backend/.env (which is git-ignored) and fill in your own values.

# Admin account created/restored on every start. Password: at least 8 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Signs login tokens. Use a long random value in production.
# SECRET_KEY=

# Load demo data (10+ records per table) on startup when there are no projects yet.
# LOAD_DEMO_DATA=true
